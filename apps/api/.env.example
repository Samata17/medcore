# Copy to apps/api/.env and change the secrets. NEVER commit the real .env.

NODE_ENV=development
API_PORT=4100
# Hospital local time zone (doctor hours, "today", reminders)
APP_TIMEZONE=Asia/Kolkata
# Comma-separated list of allowed browser origins (CORS)
WEB_ORIGIN=http://localhost:3000
# Proxies in front of the API: 1 = hosting load balancer; 2 = also the website's sign-in proxy
# (NEXT_PUBLIC_AUTH_PROXY=true on the website). See docs/DEPLOYMENT.md.
TRUST_PROXY=1

# Matches docker-compose.yml (development only — use a strong password elsewhere)
DATABASE_URL=postgresql://medcore:medcore_dev_password@localhost:5433/medcore?schema=public
REDIS_URL=redis://localhost:6380

# Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=CHANGE_ME_to_a_long_random_string_at_least_32_chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=7
# Used to hash OTP codes (HMAC); must also be long and random
OTP_SECRET=CHANGE_ME_to_another_long_random_string_32_chars

# Cookie settings. Use "none" + secure when frontend and API are on different sites.
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# Email (optional). If SMTP_HOST is empty, emails are printed to the API console
# in development so you can read the OTP codes. In production SMTP is required.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="MedCore HMS <no-reply@medcore.local>"

# Online payments — Razorpay TEST MODE keys (https://dashboard.razorpay.com → Test mode → API keys).
# Leave empty to disable online payment; patients then pay at the counter.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional: secret for the webhook POST /api/v1/billing/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=

# Where uploaded lab reports are stored (relative to apps/api)
UPLOAD_DIR=uploads

# Password for every fictional seeded account (development only)
SEED_PASSWORD=Demo@12345
