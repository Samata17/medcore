# Copy to .env.local
NEXT_PUBLIC_API_URL=http://localhost:4100/api/v1
# Set to true when the website and API are on different domains (e.g. *.vercel.app + *.onrender.com):
# sign-in requests then go through this website so users stay signed in after a reload in every browser.
# Not needed locally. Changing it requires a rebuild/redeploy.
NEXT_PUBLIC_AUTH_PROXY=false
# Optional webhook for contact-form messages. Empty = log on server only.
CONTACT_WEBHOOK_URL=
