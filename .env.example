# ------------------------------------------------------------------
# MedCore HMS has one env file per app. Copy the matching example:
#
#   apps/api/.env.example  ->  apps/api/.env        (backend: database, JWT, SMTP)
#   apps/web/.env.example  ->  apps/web/.env.local  (frontend: API URL)
#
# NEVER commit real .env files. Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
# Optional overrides for docker-compose host ports (defaults shown):
MEDCORE_PG_PORT=5433
MEDCORE_REDIS_PORT=6380
# ------------------------------------------------------------------
